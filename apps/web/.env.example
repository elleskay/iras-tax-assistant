# Copy to .env.local and fill in. Everything is optional: each integration
# no-ops cleanly when its variable is unset, so the app runs with none of them
# (the assistant needs at least one model key to answer, though).
#
# Production note: env vars are baked into the Lambda at synth time, so every
# runtime variable must be wired in BOTH infra/cdk/web/lib/web-stack.ts and the
# deploy workflow's CDK step (docs/DEPLOY.md #13).

# Model providers. Anthropic is the default provider; OpenAI powers the cheap
# routed models and the gateway's cross-provider fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override for the default agent (registry id or provider id).
# ANTHROPIC_MODEL=

# RAG service (services/rag). Unset disables retrieval; the assistant falls
# back to the built-in fact lookup.
# RAG_SERVICE_URL=http://localhost:8000
# Shared bearer token; must match the service's RAG_SERVICE_TOKEN.
# RAG_SERVICE_TOKEN=

# JSON store (lib/store.ts). Unset uses local files in the working directory
# (override the directory with STORE_DIR). Set a bucket for S3 in production.
# STORE_BUCKET=
# STORE_DIR=

# Upstash rate limiting (lib/rate-limit.ts). Unset fails open (no limits).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
